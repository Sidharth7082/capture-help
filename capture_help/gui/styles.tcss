/* =========================================================
   Capture Help — MyGlass frosted-glass theme
   Layered surfaces, soft accents, floating panels.
   (This Textual build has no border-radius/text-shadow, so
   the "glass" look comes from layered backgrounds, soft
   borders and opacity.)
   ========================================================= */

Screen {
    background: #0d1017;
    /* Layer stack (bottom -> top): wallpaper, dark overlay, glass UI.
       Textual's own loading / toast / tooltip layers sit above "ui". */
    layers: wallpaper overlay ui;
}

/* ---------- Background & dark-overlay layers (beneath all UI) ----------
   The wallpaper is the deepest opaque surface; the dark overlay dims it and
   sits between it and the glass UI. Both are absolute and never reflow the
   layout, and the UI panels above them are opaque, so nothing can ever bleed
   through the content. */
#wallpaper {
    layer: wallpaper;
    position: absolute;
    width: 100%;
    height: 100%;
    background: #0a0d13;
}

#dark-overlay {
    layer: overlay;
    position: absolute;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.45);
}

/* ---------- Header (compact hero) ---------- */
#app-header {
    layer: ui;
    background: #12161f;
    border-bottom: solid #1b2230;
    height: auto;
    padding: 1 2 1 2;
}

#hero-row {
    height: auto;
    align-vertical: middle;
}

#app-title {
    color: #e8edf4;
    text-style: bold;
}

#app-subtitle {
    color: #63c6e2;
    text-style: bold;
    margin: 0 0 0 1;
}

/* Single-line workspace status strip */
#workspace-strip {
    height: auto;
    margin: 0 0 0 1;
    align-vertical: middle;
}

#strip-project {
    color: #8f9aa9;
}

.strip-pill {
    color: #8f9aa9;
    padding: 0 1 0 1;
    margin: 0 0 0 1;
    background: #171c28;
    border: round #1d2432;
}

.strip-accent {
    color: #63c6e2;
}

.strip-git-clean {
    color: #4ed98c;
}

.strip-git-dirty {
    color: #e5b95c;
}

/* ---------- Body split ---------- */
#body {
    layer: ui;
    height: 1fr;
}

/* ---------- Sidebar ---------- */
#sidebar {
    background: #11151d;
    border-right: solid #1b2230;
    width: 30;
    padding: 1 1 1 1;
}

.sidebar-section {
    background: #161b26;
    border: round #1d2432;
    padding: 0 1 0 1;
    margin: 0 0 1 0;
    height: auto;
}

.sidebar-section-title {
    color: #63c6e2;
    text-style: bold;
}

.sidebar-item {
    color: #8f9aa9;
    padding: 0 0 0 1;
}

.sidebar-item:hover {
    color: #e8edf4;
    background: #1d2432;
}

.sidebar-section OptionList {
    background: transparent;
    border: none;
    height: auto;
}

.sidebar-section OptionList > .option-list--option {
    color: #8f9aa9;
    padding: 0 0 0 1;
    height: auto;
    min-height: 2;
}

.sidebar-section OptionList > .option-list--option:hover,
.sidebar-section OptionList > .option-list--option-selected {
    background: #1d2432;
    color: #e8edf4;
}

/* ---------- Chat column ---------- */
#chat-column {
    height: 1fr;
}

#chat {
    height: 1fr;
    background: #0a0d13;
    padding: 1 2 1 2;
    scrollbar-background: #171c28;
    scrollbar-color: #3a7d92;
    transition: opacity 220ms linear;
}

/* ---------- Chat messages ---------- */
.chat-message {
    height: auto;
    margin: 0 0 1 0;
    transition: opacity 250ms linear;
}

.chat-message.enter {
    opacity: 0;
}

.bubble {
    height: auto;
    max-width: 82%;
    padding: 1 2 1 2;
    background: #161b26;
}

/* User bubble — right aligned */
.role-user {
    align-horizontal: right;
}

.role-user .bubble {
    background: #1c3140;
    border: round #2c4a5c;
}

.role-user .bubble Markdown,
.role-user .bubble * {
    background: transparent;
}

/* Assistant bubble — left aligned glass card */
.role-assistant {
    align-horizontal: left;
}

.role-assistant .bubble {
    background: #161b26;
    border: round #1d2432;
    color: #e8edf4;
}

.role-assistant .bubble Markdown {
    background: transparent;
}

/* Tool execution card */
.role-tool {
    align-horizontal: left;
}

.role-tool .bubble {
    background: #181d29;
    border: round #232b3c;
    color: #a9b4c2;
    max-width: 100%;
}

/* Error / warning cards */
.role-error {
    align-horizontal: left;
}

.role-error .bubble {
    background: #241419;
    border: round #4a2330;
    color: #f2556f;
    max-width: 100%;
}

.role-warning {
    align-horizontal: left;
}

.role-warning .bubble {
    background: #241d10;
    border: round #4a3c1d;
    color: #e5b95c;
    max-width: 100%;
}

.role-system {
    align-horizontal: center;
}

.role-system .bubble {
    background: transparent;
    border: none;
    color: #5d6878;
    max-width: 100%;
}

/* Thinking row */
#thinking-row {
    height: 1;
    margin: 0 0 1 0;
    background: #151a24;
    border: round #1d2432;
    padding: 0 1 0 1;
}

#thinking-label {
    color: #63c6e2;
    text-style: bold;
}

/* ---------- Input ---------- */
#input-area {
    height: auto;
    background: #12161f;
    border-top: solid #1b2230;
    padding: 1 2 1 2;
}

#prompt-input {
    background: #171c28;
    border: round #2c4a5c;
    color: #e8edf4;
    padding: 0 2 0 2;
    height: 3;
}

#prompt-input:focus {
    border: round #63c6e2;
}

#prompt-hints {
    color: #5d6878;
    padding: 0 0 0 1;
}

/* ---------- Slash-command popup ---------- */
#slash-popup {
    display: none;
    height: auto;
    max-height: 12;
    background: #161b29;
    border: round #2c4a5c;
    margin: 0 0 1 0;
}

#slash-options {
    height: auto;
    max-height: 11;
    padding: 0;
}

#slash-options > .option-list--option {
    color: #c7d3e0;
    padding: 0 2 0 2;
    text-style: none;
}

#slash-options > .option-list--option--highlight {
    background: #223047;
    color: #63c6e2;
}

#slash-options:focus {
    border: none;
}

/* ---------- Status footer ---------- */
#status-footer {
    layer: ui;
    background: #11151d;
    border-top: solid #1b2230;
    height: 2;
    padding: 0 1 0 1;
    align-vertical: middle;
}

.status-item {
    color: #8f9aa9;
    padding: 0 0 0 1;
}

.status-spacer {
    width: 1fr;
    height: auto;
}

.status-item.model {
    background: #1d2432;
    border: round #3a7d92;
    color: #63c6e2;
    padding: 0 1 0 1;
    margin: 0 0 0 1;
    text-style: bold;
}

.status-item.model:hover {
    text-style: bold underline;
    color: #9adcf0;
    border: round #63c6e2;
}

.status-item.model-local {
    color: #4ed98c;
    border: round #2c5a46;
}

.status-item.model-cloud {
    color: #9adcf0;
}

.status-item.git-clean {
    color: #4ed98c;
}

.status-item.git-dirty {
    color: #e5b95c;
}

.status-item.version {
    color: #5d6878;
}

.status-item.cost .value {
    color: #4ed98c;
}

.status-item.state-streaming .value {
    color: #e5b95c;
}

/* ---------- Landing screen (empty state) ---------- */
#landing {
    display: block;
    height: 1fr;
    padding: 2 4 1 4;
    overflow-y: auto;
    scrollbar-background: #171c28;
    scrollbar-color: #3a7d92;
    transition: opacity 220ms linear;
}

#landing-question {
    color: #e8edf4;
    text-style: bold;
    text-align: center;
    margin: 0 0 0 0;
}

#landing-sub {
    color: #5d6878;
    text-align: center;
    margin: 0 0 2 0;
}

#example-row {
    height: auto;
    grid-size: 4;
    grid-columns: 1fr 1fr 1fr 1fr;
    grid-gutter: 1;
    margin: 0 0 1 0;
}

.chip {
    background: #171c28;
    border: round #232b3c;
    color: #a9b4c2;
    padding: 0 1 0 1;
    height: 3;
    min-width: 0;
}

.chip:hover {
    background: #2c4a5c;
    border: round #63c6e2;
    color: #e8edf4;
}

.chip:focus {
    border: round #63c6e2;
    color: #e8edf4;
}

.section-label {
    color: #63c6e2;
    text-style: bold;
    text-align: center;
    margin: 1 0 1 0;
}

/* Primary action button (Ask Capture Help) */
.qa-primary {
    background: #1f3a47;
    border: round #63c6e2;
    color: #9adcf0;
    text-style: bold;
    height: 3;
    margin: 0 0 1 0;
    width: 60%;
    align-horizontal: center;
}

.qa-primary:hover {
    background: #2c4a5c;
    border: round #9adcf0;
    color: #e8edf4;
}

.qa-primary:focus {
    border: round #9adcf0;
    background: #2c4a5c;
}

#qa-grid {
    height: auto;
    grid-size: 3;
    grid-columns: 1fr 1fr 1fr;
    grid-gutter: 1;
    margin: 0 0 1 0;
    align-horizontal: center;
    width: 70%;
}

.qa-btn {
    background: #161b26;
    border: round #1d2432;
    color: #e8edf4;
    padding: 0 1 0 1;
    height: 3;
}

.qa-secondary:hover {
    background: #2c4a5c;
    border: round #63c6e2;
    color: #e8edf4;
}

.qa-secondary:focus {
    border: round #63c6e2;
    color: #e8edf4;
    text-style: bold;
}

/* Today's Workspace summary */
.workspace-panel {
    height: auto;
    width: 60%;
    align-horizontal: center;
    background: #12161f;
    border: round #1d2432;
    padding: 0 2 1 2;
    margin: 0 0 1 0;
}

#workspace-items {
    height: auto;
}

.ws-row {
    height: auto;
}

.ws-key {
    color: #8f9aa9;
    padding: 0 0 0 0;
}

.ws-value {
    color: #e8edf4;
    text-style: bold;
}

.ws-good {
    color: #4ed98c;
}

/* ---------- Debug panel (collapsible, right side) ---------- */
#debug-panel {
    display: none;
    width: 46;
    background: #0f131a;
    border-left: solid #1b2230;
}

#debug-panel Collapsible {
    height: 1fr;
}

#debug-log {
    height: 1fr;
    background: #0d1017;
    padding: 0 1 0 1;
}

/* ---------- Modal screens ---------- */
ModalScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.65);
}

.modal-card {
    background: #161b26;
    border: round #2c4a5c;
    width: 70;
    height: auto;
    max-height: 80%;
    padding: 1 2 1 2;
}

.modal-title {
    color: #63c6e2;
    text-style: bold;
    text-align: center;
    margin: 0 0 1 0;
}

.modal-card OptionList {
    border: round #1d2432;
    background: #12161f;
    height: auto;
    max-height: 22;
}

.modal-card OptionList > .option-list--option {
    color: #8f9aa9;
}

.modal-card OptionList > .option-list--option:hover {
    background: #1d2432;
    color: #e8edf4;
}

.modal-card OptionList > .option-list--option-selected {
    background: #2c4a5c;
    color: #e8edf4;
    text-style: bold;
}

.modal-card .modal-hint {
    color: #5d6878;
    text-align: center;
    margin: 1 0 0 0;
}

.modal-card .modal-buttons {
    height: 3;
    margin: 1 0 0 0;
    align-horizontal: center;
    align-vertical: middle;
}

.modal-card .modal-buttons Button {
    margin: 0 1 0 1;
}

/* ---------- Buttons ---------- */
Button {
    background: #1d2432;
    color: #e8edf4;
    border: round #232b3c;
}

Button:hover {
    background: #2c4a5c;
    border: round #63c6e2;
}

Button:focus {
    border: round #63c6e2;
}

/* ---------- Notifications ---------- */
.notification {
    background: #161b26;
    border: round #63c6e2;
    color: #e8edf4;
}

/* ---------- Subtle motion ----------
   CSS animations are driven from Python (widget.animate) since this Textual
   build's tokenizer does not accept @keyframes; transitions below smooth the
   property changes the app makes. */

.qa-primary, .qa-secondary, .chip {
    transition: opacity 120ms linear;
}

.chat-message.enter {
    transition: opacity 300ms linear;
}

#prompt-input {
    transition: opacity 150ms linear;
}

/* Gentle pulse while the model is streaming */
.status-item.state-streaming {
    text-style: bold;
}